#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet -- Makefile .githooks/pre-commit .gitmodules; then
    echo "strings-check: stage changes to the hook, Makefile and .gitmodules before committing." >&2
    exit 1
fi
expected=$(git ls-files --stage -- tools/StringCatalogDoctor | awk '{print $2}')
actual=$(git -C tools/StringCatalogDoctor rev-parse HEAD 2>/dev/null || true)
if [ -z "$expected" ] || [ "$expected" != "$actual" ] ||
   ! git -C tools/StringCatalogDoctor diff --quiet HEAD --; then
    echo "strings-check: initialize the staged StringCatalogDoctor submodule at its pinned revision with no local changes." >&2
    exit 1
fi
exec make strings-check STRINGS_CHECK_STAGED=1
