    "Add a TypeSafe.ai API key to ask Jev for structured Noul, Choice, and Score answers. The key is stored securely in this device's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a TypeSafe.ai API key to ask Jev for structured Noul, Choice, and Score answers. The key is stored securely in this device's Keychain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте API-ключ TypeSafe.ai, чтобы получать от Jev структурированные ответы «да/нет», варианты и оценку вероятности. Ключ хранится в Связке ключей этого устройства."
          }
        }
      }
    },
